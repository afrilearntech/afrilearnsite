[Unit]
Description=Afrilearn Gunicorn application server
Requires=gunicorn.socket
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=afrilearn
Group=afrilearn
SupplementaryGroups=www-data
WorkingDirectory=/srv/afrilearnsite
Environment=DJANGO_DATABASE_PATH=/var/lib/afrilearnsite/db/db.sqlite3
ExecStart=/srv/afrilearnsite/venv/bin/gunicorn \
    --access-logfile - \
    --workers 3 \
    --bind unix:/run/gunicorn.sock \
    afrilearnsite.wsgi:application
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/afrilearnsite
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
